{
  "expo": {
    "name": "fashionai-mobile",
    "slug": "fashionai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fashionaimobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fashionai.mobile"
    },
    "android": {
      "package": "com.fashionai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/be-vietnam-pro/400Regular/BeVietnamPro_400Regular.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/500Medium/BeVietnamPro_500Medium.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/600SemiBold/BeVietnamPro_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/700Bold/BeVietnamPro_700Bold.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/800ExtraBold/BeVietnamPro_800ExtraBold.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/900Black/BeVietnamPro_900Black.ttf",
              "./node_modules/@expo-google-fonts/be-vietnam-pro/900Black_Italic/BeVietnamPro_900Black_Italic.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Be Vietnam Pro",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/400Regular/BeVietnamPro_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/500Medium/BeVietnamPro_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/600SemiBold/BeVietnamPro_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/700Bold/BeVietnamPro_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/800ExtraBold/BeVietnamPro_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/900Black/BeVietnamPro_900Black.ttf",
                    "weight": 900
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/be-vietnam-pro/900Black_Italic/BeVietnamPro_900Black_Italic.ttf",
                    "weight": 900,
                    "style": "italic"
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "FashionAI cần truy cập ảnh để phân tích phong cách của bạn.",
          "cameraPermission": "FashionAI cần dùng camera để chụp ảnh phân tích phong cách của bạn."
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
