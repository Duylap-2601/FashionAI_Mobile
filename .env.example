# Standard local backend configuration: PORT=3002 and API_PREFIX=api.
EXPO_PUBLIC_API_URL=http://localhost:3002/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3002

# A physical device's localhost is the device itself. Use the development
# machine's LAN IP instead (for example, http://192.168.1.50:3002/api).
# Android Emulator may require http://10.0.2.2:3002/api instead of localhost.

# EAS project ID for Expo push tokens. Prefer adding extra.eas.projectId via
# `eas init`; this env var is a fallback for local development builds.
EXPO_PUBLIC_EAS_PROJECT_ID=
